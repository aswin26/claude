# ─────────────────────────────────────────────────────────────────
# Appian Package Manager – Environment Configuration
# ─────────────────────────────────────────────────────────────────
# 1. Copy this file:  cp scripts/.env.example scripts/.env
# 2. Fill in your values below
# 3. Never commit .env to source control (it is in .gitignore)
# ─────────────────────────────────────────────────────────────────

# ── Required ──────────────────────────────────────────────────────

# Your Appian site domain (no https://, no trailing slash)
# Example: mycompany.appiancloud.com
APPIAN_DOMAIN=

# API key linked to a service account (created in Admin Console → API Keys)
APPIAN_API_KEY=

# UUID of the application whose packages you want to list
# Found in Appian Designer → Application → Properties → UUID
APPIAN_APP_UUID=

# ── Optional ──────────────────────────────────────────────────────

# Directory where downloaded .zip packages will be saved (default: ./downloads)
# APPIAN_DOWNLOAD_DIR=./downloads

# How often to poll for export completion, in seconds (default: 5)
# APPIAN_POLL_INTERVAL=5

# Maximum number of polling attempts before timing out (default: 60 → ~5 min)
# APPIAN_MAX_POLL_TRIES=60
