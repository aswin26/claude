# APPIAN ENVIRONMENT
# Preferred: run `python scripts/setup_credentials.py` to save credentials
# securely to ~/.appian/credentials.json (never committed to git).
#
# Alternatively, copy this file to scripts/.env and fill in values
# (useful for CI/CD pipelines where a home directory is not available).

APPIAN_URL=https://your-env.appiancloud.com
APPIAN_API_KEY=your-api-key-here

# OPTIONAL: Default application UUID (saves typing --app-uuid every time)
APPIAN_APP_UUID=

# OPTIONAL: Deployment metadata
APPIAN_DEPLOY_NAME=Automated Deployment
APPIAN_DEPLOY_DESCRIPTION=Deployed via appian_workflow.py

# OPTIONAL: Proxy
# HTTP_PROXY=http://proxy.company.com:8080
# HTTPS_PROXY=http://proxy.company.com:8080

# OPTIONAL: Timeouts (seconds)
# REQUEST_TIMEOUT=60
# DEPLOY_POLL_INTERVAL=10
# DEPLOY_POLL_TIMEOUT=600

# OPTIONAL: Flags
# SKIP_INSPECT=false
# AUTO_APPROVE=false
