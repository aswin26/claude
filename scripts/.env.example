# SOURCE ENVIRONMENT (export code FROM here)
APPIAN_SOURCE_URL=https://your-dev-env.appiancloud.com
APPIAN_SOURCE_API_KEY=your-dev-api-key-here

# TARGET ENVIRONMENT (deploy code TO here)
APPIAN_TARGET_URL=https://your-uat-env.appiancloud.com
APPIAN_TARGET_API_KEY=your-uat-api-key-here

# OPTIONAL: DEFAULT APPLICATION
APPIAN_APP_UUID=

# OPTIONAL: DEPLOYMENT METADATA
APPIAN_DEPLOY_NAME=Automated Deployment
APPIAN_DEPLOY_DESCRIPTION=Deployed via appian_workflow.py

# OPTIONAL: PROXY
# HTTP_PROXY=http://proxy.company.com:8080
# HTTPS_PROXY=http://proxy.company.com:8080

# OPTIONAL: TIMEOUTS
# REQUEST_TIMEOUT=60
# DEPLOY_POLL_INTERVAL=10
# DEPLOY_POLL_TIMEOUT=600

# OPTIONAL: FLAGS
# SKIP_INSPECT=false
# AUTO_APPROVE=false
